  {"role": "I-ONE Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1, "print": 1},
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "share": 1, "print": 1}
 ],
 "search_fields": "agent_name,agent_code,agent_type,company,department",
 "sort_field": "modified",
 "sort_order": "DESC",
