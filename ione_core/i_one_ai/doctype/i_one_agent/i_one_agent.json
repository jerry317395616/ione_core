 ],
 "fields": [
  {"fieldname": "identity_tab", "fieldtype": "Tab Break", "label": "身份"},
  {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "员工档案"},
  {"fieldname": "agent_code", "fieldtype": "Data", "label": "员工编码", "description": "仅使用小写字母、数字和短横线，例如 finance-assistant", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "agent_name", "fieldtype": "Data", "label": "员工姓名", "reqd": 1, "in_list_view": 1, "search_index": 1},
  {"fieldname": "agent_type", "fieldtype": "Select", "label": "岗位类型", "options": "综合助理\n财务助理\n销售助理\n人事助理\n客服助理\n知识助理\n运营助理\n自定义岗位", "default": "综合助理", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "avatar", "fieldtype": "Attach Image", "label": "头像"},
  {"fieldname": "column_break_identity", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "任职状态", "options": "草稿\n试用\n在职\n暂停\n离职", "default": "草稿", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "所属公司", "options": "Company", "in_standard_filter": 1},
  {"fieldname": "department", "fieldtype": "Link", "label": "所属部门", "options": "Department"},
  {"fieldname": "designation", "fieldtype": "Link", "label": "岗位", "options": "Designation"},
  {"fieldname": "supervisor", "fieldtype": "Link", "label": "直属负责人", "options": "User"},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "岗位说明"},
  {"fieldname": "job_tab", "fieldtype": "Tab Break", "label": "职责"},
  {"fieldname": "job_section", "fieldtype": "Section Break", "label": "岗位职责"},
  {"fieldname": "responsibilities", "fieldtype": "Text Editor", "label": "工作职责", "description": "说明该 AI 员工负责什么、交付什么，以及明确不负责什么。"},
  {"fieldname": "instructions", "fieldtype": "Long Text", "label": "补充工作指令", "description": "系统会自动加入身份、权限和审批规则，这里只填写岗位特有要求。"},
  {"fieldname": "operating_section", "fieldtype": "Section Break", "label": "工作方式"},
  {"fieldname": "operating_mode", "fieldtype": "Select", "label": "工作模式", "options": "辅助\n半自动\n自动", "default": "辅助", "reqd": 1},
  {"fieldname": "default_approver", "fieldtype": "Link", "label": "默认审批人", "options": "User"},
  {"fieldname": "column_break_operating", "fieldtype": "Column Break"},
  {"fieldname": "daily_task_limit", "fieldtype": "Int", "label": "每日任务上限", "default": "50", "non_negative": 1},
  {"fieldname": "max_retries", "fieldtype": "Int", "label": "失败重试次数", "default": "2", "non_negative": 1},
  {"fieldname": "work_start_time", "fieldtype": "Time", "label": "工作开始时间"},
  {"fieldname": "work_end_time", "fieldtype": "Time", "label": "工作结束时间"},
  {"fieldname": "flow_tab", "fieldtype": "Tab Break", "label": "模型与能力"},
  {"fieldname": "model_section", "fieldtype": "Section Break", "label": "Flow 模型"},
  {"fieldname": "flow_model", "fieldtype": "Link", "label": "大模型", "options": "Flow Model"},
  {"fieldname": "max_iterations", "fieldtype": "Int", "label": "单次最大推理轮数", "default": "20", "non_negative": 1},
  {"fieldname": "column_break_model", "fieldtype": "Column Break"},
  {"fieldname": "flow_agent", "fieldtype": "Link", "label": "Flow 执行智能体", "options": "Flow Agent", "read_only": 1},
  {"fieldname": "last_active", "fieldtype": "Datetime", "label": "最近运行时间", "read_only": 1},
  {"fieldname": "tools_section", "fieldtype": "Section Break", "label": "工具与知识"},
  {"fieldname": "tools", "fieldtype": "Table MultiSelect", "label": "可用工具", "options": "I-ONE Agent Tool", "description": "只授予完成岗位职责必需的工具。"},
  {"fieldname": "knowledge_bases", "fieldtype": "Table MultiSelect", "label": "知识库", "options": "I-ONE Agent Knowledge Base"},
  {"fieldname": "permissions_tab", "fieldtype": "Tab Break", "label": "权限"},
  {"fieldname": "permissions_section", "fieldtype": "Section Break", "label": "服务身份"},
  {"fieldname": "roles", "fieldtype": "Table MultiSelect", "label": "业务角色", "options": "I-ONE Agent Role", "description": "Flow 工具会以这个服务用户的角色权限执行。"},
  {"fieldname": "service_user_email", "fieldtype": "Data", "label": "服务用户邮箱", "options": "Email", "description": "留空时自动生成为 ai-员工编码@myyr.top。"},
  {"fieldname": "service_user", "fieldtype": "Link", "label": "服务用户", "options": "User", "read_only": 1},
  {"fieldname": "boundary_section", "fieldtype": "Section Break", "label": "业务边界"},
  {"fieldname": "allowed_modules", "fieldtype": "Small Text", "label": "允许访问的应用", "description": "每行填写一个应用或模块名称，作为 AI 员工的明确工作边界。"},
  {"fieldname": "allowed_doctypes", "fieldtype": "Small Text", "label": "允许访问的单据类型", "description": "每行填写一个 DocType；实际读写仍受服务用户角色权限控制。"},
  {"fieldname": "runtime_tab", "fieldtype": "Tab Break", "label": "运行"},
  {"fieldname": "schedule_section", "fieldtype": "Section Break", "label": "定时工作"},
  {"fieldname": "schedule_enabled", "fieldtype": "Check", "label": "启用定时任务", "default": "0"},
  {"fieldname": "cron_expression", "fieldtype": "Data", "label": "Cron 表达式", "depends_on": "eval:doc.schedule_enabled", "mandatory_depends_on": "eval:doc.schedule_enabled", "description": "标准 5 段 Cron，例如 0 9 * * 1-5 表示工作日 9:00。"},
  {"fieldname": "schedule_prompt", "fieldtype": "Long Text", "label": "定时任务指令", "depends_on": "eval:doc.schedule_enabled", "mandatory_depends_on": "eval:doc.schedule_enabled"},
  {"fieldname": "column_break_schedule", "fieldtype": "Column Break"},
  {"fieldname": "flow_trigger", "fieldtype": "Link", "label": "Flow 定时触发器", "options": "Flow Trigger", "read_only": 1},
  {"fieldname": "published_at", "fieldtype": "Datetime", "label": "最近发布时间", "read_only": 1}
 ],
 "index_web_pages_for_search": 0,
 "links": [
  {"link_doctype": "I-ONE AI Task", "link_fieldname": "assigned_agent"}
 ],
